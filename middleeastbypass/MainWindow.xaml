<Window x:Class="middleeastbypass.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:middleeastbypass"
        mc:Ignorable="d"
        Title="chat settings editor" Height="200" Width="300" ResizeMode="CanMinimize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="25"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock>app created by defacube [watchr]</TextBlock>

        <TextBlock Grid.Row="1">Chat Type</TextBlock>
        <ComboBox Name="chatTypeBox"
                  Width="200"
                  Height="30"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  SelectionChanged="chatTypeBox_SelectionChanged"
                  Grid.Row="1" Margin="100,0,0,0">
            <ComboBoxItem Content="AllUsers" />
            <ComboBoxItem Content="NoOne" />
        </ComboBox>

        <TextBlock Grid.Row="2">Whisper Type</TextBlock>
        <ComboBox Name="whisperTypeBox"
          Width="200"
          Height="30"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          SelectionChanged="whisperTypeBox_SelectionChanged"
          Grid.Row="2" Margin="100,0,0,0">
            <ComboBoxItem Content="AllUsers" />
            <ComboBoxItem Content="NoOne" />
        </ComboBox>

        <Button Grid.Row="3" FontSize="48" Name="LaunchButton" Click="LaunchButton_Click">Launch</Button>
    </Grid>
</Window>
